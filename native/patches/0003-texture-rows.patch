+/// Upload layout with one immutable column plan per mip. Rows, array layers and
+/// later refreshes share it. Dropping the staging object releases its plans.
+pub struct PreparedLayout {
+    layout: Layout,
+    plans: Vec<RowPlan>,
+}
+
+impl std::ops::Deref for PreparedLayout {
+    type Target = Layout;
+
+    fn deref(&self) -> &Layout {
+        &self.layout
+    }
+}
+
+impl PreparedLayout {
+    pub fn new(layout: Layout) -> Self {
+        let plans = if layout.desc.swizzle == Swizzle::LINEAR || !layout.addressable() {
+            Vec::new()
+        } else {
+            layout.mips.iter().map(|m| layout.row_plan(m)).collect()
+        };
+        Self { layout, plans }
+    }
+
+    pub fn detile(
+        &self,
+        tiled: &[u8],
+        mip: u32,
+        slice: u32,
+        linear: &mut [u8],
+        row_pitch: usize,
+        depth_pitch: usize,
+    ) -> Result<(), Error> {
+        self.layout.walk(
+            tiled.len(),
+            mip,
+            slice,
+            linear.len(),
+            row_pitch,
+            depth_pitch,
+            self.plans.get(mip as usize),
+            |t, l, n| {
+                linear[l..][..n].copy_from_slice(&tiled[t..][..n]);
+            },
+        )
+    }
+
+    pub fn tile(
+        &self,
+        tiled: &mut [u8],
+        mip: u32,
+        slice: u32,
+        linear: &[u8],
+        row_pitch: usize,
+        depth_pitch: usize,
+    ) -> Result<(), Error> {
+        self.layout.walk(
+            tiled.len(),
+            mip,
+            slice,
+            linear.len(),
+            row_pitch,
+            depth_pitch,
+            self.plans.get(mip as usize),
+            |t, l, n| {
+                tiled[t..][..n].copy_from_slice(&linear[l..][..n]);
+            },
+        )
     }
 }
 
