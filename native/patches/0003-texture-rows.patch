+                                        depth,
+                                    )
+                                    .unwrap();
+                            }
+                        }
+                    }
+                }
+                now.elapsed()
+            };
+            let _ = (sample(false), sample(true));
+            let mut rebuilt = Vec::new();
+            let mut cached = Vec::new();
+            for i in 0..11 {
+                if i % 2 == 0 {
+                    rebuilt.push(sample(false));
+                    cached.push(sample(true));
+                } else {
+                    cached.push(sample(true));
+                    rebuilt.push(sample(false));
+                }
+            }
+            rebuilt.sort();
+            cached.sort();
