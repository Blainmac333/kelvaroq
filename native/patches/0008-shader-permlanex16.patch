 /// modules take this lock too.
 pub(super) static ONE_AT_A_TIME: std::sync::Mutex<()> = std::sync::Mutex::new(());
 
+#[test]
+fn permlanex16_reads_both_selector_tables_and_the_opposite_row() {
+    let _one = ONE_AT_A_TIME.lock().unwrap_or_else(|e| e.into_inner());
+    let host = match Host::new(false).or_else(|_| Host::new(true)) {
+        Ok(host) => host,
+        Err(e) => panic!("no SM 6.6 device for per-lane readback: {e}"),
+    };
+    let permute = vop3(0x378, 1, vgpr(0), sgpr(0), sgpr(1));
+    let columns = [3, 5, 7, 9, 11, 13, 15, 1, 2, 4, 6, 8, 10, 12, 14, 0];
+    for wave64 in [false, true] {
+        // Exercise the same 32-lane host target for both guest waves.
+        let previous = lower::TEST_HOST_WAVE.replace(Some(32));
+        let shader = build_cs_with_store(&permute, 64, 0, wave64, true);
+        lower::TEST_HOST_WAVE.set(previous);
+        let (root, pso) = host.compute_pipeline(&shader)
+            .unwrap_or_else(|e| panic!("compute PSO, wave64={wave64}: {e}"));
+        let mut data = vec![0; shader.user_data_dwords().max(1) as usize];
+        for u in &shader.user_data {
+            data[u.index as usize] = match (u.root, u.slot, u.dword) {
+                (RootType::Constants, 0, 0) => 0x1fdb_9753,
+                (RootType::Constants, 0, 1) => 0x0eca_8642,
+                _ => 0,
+            };
+        }
+        let output = host.dispatch(&root, &pso, &Dispatch {
+            roots: vec![(0, Root::Constants(data))],
+            views: &[View::RawUav(64)],
+            samplers: &[],
+            groups: [1, 1, 1],
+        }).expect("compute dispatch and readback");
+        let expected: Vec<_> = (0..64).map(|id| {
+            let other_row = [16, 0, 48, 32][id / 16];
+            other_row + columns[id % 16]
+        }).collect();
+        assert_eq!(output[0], expected, "wave64={wave64}");
+    }
+}
+
+#[test]
