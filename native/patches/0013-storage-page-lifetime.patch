 const PAGE: usize = 64 * 1024;
 
+#[derive(Clone, Copy)]
+struct QueuedRead {
+    request: Request,
+    first_page: PageAtEnqueue,
+}
+
+// The page number is kept only for equality. Only the separate, address-free
+// comparison below can be formatted for logs.
+#[derive(Clone, Copy)]
+enum PageAtEnqueue {
+    Off,
+    Unreadable,
+    Read { number: usize, known: bool },
+}
+
+#[derive(Debug, PartialEq, Eq)]
+enum FirstPageComparison {
+    Off,
+    UnreadableAtEnqueue,
+    EmptyAtWorker,
+    Observed {
+        enqueue_zero: bool,
+        enqueue_known: bool,
+        worker_zero: bool,
+        same: bool,
+    },
+}
+
+impl PageAtEnqueue {
+    fn capture(request: &Request, enabled: bool) -> Self {
+        use windows_sys::Win32::System::{
+            Diagnostics::Debug::ReadProcessMemory, Threading::GetCurrentProcess,
+        };
+        let size = if request.options & (ZLIB | BCPACK) == 0 {
+            request.source_size
+        } else {
+            request.destination_size
+        };
+        if !enabled
+            || request.options & PAGE_DESTINATION == 0
+            || request.destination.is_null()
+            || size == 0
+        {
+            return Self::Off;
+        }
+        let mut number = 0usize;
+        let mut copied = 0;
+        // SAFETY: the kernel reads exactly one metadata word, even for a
+        // multi-page request. An inaccessible list is only a diagnostic outcome.
+        let ok = unsafe {
+            ReadProcessMemory(
+                GetCurrentProcess(),
+                request.destination,
+                (&mut number as *mut usize).cast(),
+                size_of::<usize>(),
+                &mut copied,
+            )
+        };
+        if ok == 0 || copied != size_of::<usize>() {
+            return Self::Unreadable;
+        }
+        Self::Read {
+            number,
+            known: super::xmem::has_physical_page(number),
+        }
+    }
+
+    fn compare(self, pages: &[usize]) -> FirstPageComparison {
+        match self {
+            Self::Off => FirstPageComparison::Off,
+            Self::Unreadable => FirstPageComparison::UnreadableAtEnqueue,
+            Self::Read { number, known } => match pages.first() {
+                Some(&current) => FirstPageComparison::Observed {
+                    enqueue_zero: number == 0,
+                    enqueue_known: known,
+                    worker_zero: current == 0,
+                    same: current == number,
+                },
+                None => FirstPageComparison::EmptyAtWorker,
+            },
+        }
+    }
+}
+
 enum Command {
-    Read(Request),
+    Read(QueuedRead),
     Status(Status),
 }
 
